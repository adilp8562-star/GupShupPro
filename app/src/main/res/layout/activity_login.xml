<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#120924"
    android:padding="28dp">

    <TextView
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:text="👑"
        android:textSize="54sp"
        android:gravity="center"
        android:background="#28144D"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GupShup Live"
        android:textColor="#FFD700"
        android:textSize="32sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HD Voice Party • Rocket Launch • Royal Greedy"
        android:textColor="#C4B5FD"
        android:textSize="13sp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="36dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E103C"
        android:padding="18dp"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎁 New User Instant Welcome Pack"
            android:textColor="#FFD700"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• 🪙 50,000 Free Gold Coins\n• 👑 3-Day Royal Golden VIP Frame\n• 🎡 Play Gold-Coin Greedy &amp; Win 45x"
            android:textColor="#E5E7EB"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnGoogleSignIn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="G   Continue with Google"
        android:textColor="#1A1D24"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#FFFFFF" />

    <TextView
        android:id="@+id/tvLoginStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Secure Google Login • Permanent UID &amp; Coins"
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:layout_marginTop="14dp" />

</LinearLayout>
