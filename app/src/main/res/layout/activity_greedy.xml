    private fun renderGrid(list: List>) {
        roomsGrid.removeAllViews()
        val showList = if (selectedCat == "All") list else list.filter { it["cat"] == selectedCat }
        var idx = 0
        while (idx < showList.size) {
            val row = LinearLayout(this).apply {
                orientation = LinearLayout.HORIZONTAL
                layoutParams = LinearLayout.LayoutParams(-1, -2).apply { bottomMargin = 16 }
            }
            row.addView(roomCard(showList[idx], true))
            if (idx + 1 < showList.size) {
                row.addView(roomCard(showList[idx + 1], false))
            } else {
                row.addView(Space(this).apply { layoutParams = LinearLayout.LayoutParams(0, 10, 1f) })
            }
            roomsGrid.addView(row)
            idx += 2
        }
    }

    private fun roomCard(r: Map<String, String>, leftPad: Boolean): LinearLayout {
        val id = r["id"] ?: "100101"
        val name = r["name"] ?: "VIP Room"
        val host = r["host"] ?: "Host"
        val cat = r["cat"] ?: "Royal"
        val users = r["users"] ?: "36"
        val isOff = id == "100001"
        return LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(20, 20, 20, 20)
            background = box(if (isOff) "#2E1463" else "#1E1242", if (isOff) "#FFD700" else "#6A42C2", 3, 26f)
            layoutParams = LinearLayout.LayoutParams(0, -2, 1f).apply { if (leftPad) rightMargin = 12 }
            addView(TextView(this@MainActivity).apply {
                text = if (isOff) "🛡️ OFFICIAL • 🔊 $users" else "🔴 LIVE • 🔊 $users"
                textSize = 11f
                setTypeface(null, Typeface.BOLD)
                setTextColor(Color.parseColor("#00FFAA"))
            })
            addView(TextView(this@MainActivity).apply {
                text = name
                textSize = 13f
                setTypeface(null, Typeface.BOLD)
                setTextColor(Color.WHITE)
                setPadding(0, 12, 0, 12)
                maxLines = 2
            })
            addView(TextView(this@MainActivity).apply {
                text = "👑 $host • $cat"
                textSize = 11f
                setTextColor(Color.parseColor("#FFD700"))
            })
            setOnClickListener { openLiveRoom(id, name, host, cat) }
        }
    }

