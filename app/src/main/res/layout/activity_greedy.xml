<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0719"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/greedyRootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A103C"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvGreedyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="10dp"
            android:text="👑 ROYAL 10-GREEDY ARENA"
            android:textColor="#FFD700"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGreedyBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="14dp"
            android:text="🪙 Coins: 500000  •  ⚡ Lv.100 OWNER"
            android:textColor="#00FFAA"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/greedySlotsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnGreedySpin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:backgroundTint="#FFD700"
            android:padding="14dp"
            android:text="⚡ SPIN ROYAL GREEDY"
            android:textColor="#1A0B2E"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
