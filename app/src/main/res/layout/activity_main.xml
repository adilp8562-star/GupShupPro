<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- ==================== TAB 0: HAZA PRO PARTY HOME ==================== -->
    <LinearLayout
        android:id="@+id/tabParty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#F5F7FA">

        <!-- Play Store Top Bar: Me | Popular | Search | +Room -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:paddingStart="16dp"
            android:paddingEnd="14dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/tvTopMe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Me"
                android:textColor="#8E96AA"
                android:textSize="17sp"
                android:textStyle="bold"
                android:paddingEnd="16dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Popular"
                    android:textColor="#1A1D26"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="32dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="3dp"
                    android:background="#00D4A1" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Coin Badge -->
            <TextView
                android:id="@+id/tvCoinsTop"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="#FFF3C4"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="🪙 200000"
                android:textColor="#B27800"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <!-- Search Room Icon -->
            <TextView
                android:id="@+id/btnTopSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="🔍"
                android:textSize="18sp"
                android:layout_marginEnd="6dp" />

            <!-- Create Room Icon (+ House) -->
            <TextView
                android:id="@+id/btnCreateRoom"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="#8B5CF6"
                android:gravity="center"
                android:text="🏠+"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Weekly Star Royal Event Banner -->
                <LinearLayout
                    android:id="@+id/bannerWeeklyStar"
                    android:layout_width="match_parent"
                    android:layout_height="118dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#26133D"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐉 ROYAL CARNIVAL • SEASON 1 🐉"
                        android:textColor="#FFE082"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="✨ Weekly Star ✨"
                        android:textColor="#FFD700"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Win 5,00,000 Coins + Royal Dragon Frame ➔"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 4 Event Cards Row: Ranking | Family | CP | Free 100K -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <!-- Card 1: Ranking -->
                    <LinearLayout
                        android:id="@+id/cardRanking"
                        android:layout_width="0dp"
                        android:layout_height="84dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#FDE69A"
                        android:padding="6dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ranking"
                            android:textColor="#8A5A00"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="🏆👑"
                            android:textSize="22sp" />
                    </LinearLayout>

                    <!-- Card 2: Family -->
                    <LinearLayout
                        android:id="@+id/cardFamily"
                        android:layout_width="0dp"
                        android:layout_height="84dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#BCE8FF"
                        android:padding="6dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Family"
                            android:textColor="#005B8F"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="🏰🦁"
                            android:textSize="22sp" />
                    </LinearLayout>

                    <!-- Card 3: CP -->
                    <LinearLayout
                        android:id="@+id/cardCp"
                        android:layout_width="0dp"
                        android:layout_height="84dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#E4C7FF"
                        android:padding="6dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CP"
                            android:textColor="#6B1FA6"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="💑💖"
                            android:textSize="22sp" />
                    </LinearLayout>

                    <!-- Card 4: Daily 100K Free Coins Event -->
                    <LinearLayout
                        android:id="@+id/cardDailyBonus"
                        android:layout_width="0dp"
                        android:layout_height="84dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#FFC4D6"
                        android:padding="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+100K"
                            android:textColor="#A30036"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="🎁🪙"
                            android:textSize="22sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Quick Room ID Join Strip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#FFFFFF"
                    android:paddingStart="12dp"
                    android:paddingEnd="6dp"
                    android:layout_marginTop="10dp">

                    <EditText
                        android:id="@+id/etRoomIdInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="🔍 Enter 6-digit Room ID..."
                        android:textColor="#1A1D26"
                        android:textColorHint="#9AA3B5"
                        android:inputType="number"
                        android:maxLength="6"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnJoinRoom"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="JOIN"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:backgroundTint="#00C49A" />
                </LinearLayout>

                <!-- 2-Column Live Rooms Grid Container -->
                <LinearLayout
                    android:id="@+id/liveRoomsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- ==================== TAB 1: GAMES & EVENTS CENTER ==================== -->
    <ScrollView
        android:id="@+id/tabGames"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#120726"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎰 Royal Game &amp; Mega Events"
                android:textColor="#FFD700"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Greedy 30s Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#261347"
                android:padding="18dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎡 GREEDY WHEEL (30s LIVE)"
                    android:textColor="#FFD700"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Bet Gold Coins on Crown, Pizza, Burger &amp; win up to 45x instant rewards!"
                    android:textColor="#E2D9F3"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnOpenGreedy"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:text="🔥 PLAY GREEDY NOW"
                    android:textColor="#1A0B2E"
                    android:textStyle="bold"
                    android:backgroundTint="#FFD700" />
            </LinearLayout>

            <!-- Mega Daily Free Coins Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1D2B4A"
                android:padding="18dp"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎁 DAILY 1,00,000 FREE COINS"
                    android:textColor="#00FFC8"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Claim your daily Royal Treasure Chest of 1,00,000 Gold Coins!"
                    android:textColor="#D0E1FF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnClaimDailyGames"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:text="🪙 CLAIM 1,00,000 COINS"
                    android:textColor="#102027"
                    android:textStyle="bold"
                    android:backgroundTint="#00E5B0" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ==================== TAB 2: ME (VIP PROFILE & ADMIN) ==================== -->
    <ScrollView
        android:id="@+id/tabMe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F5F7FA"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Profile Header Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#23123D"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvUserAvatarMe"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:background="#3D206B"
                    android:gravity="center"
                    android:text="👑"
                    android:textSize="44sp" />

                <TextView
                    android:id="@+id/tvUserNameMe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Royal Host"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUserUidMe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ID: 100001 • ♂️ Male • ROYAL VIP"
                    android:textColor="#FFD700"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUserBioMe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Welcome to my Royal Voice Party! 👑"
                    android:textColor="#D4C7EC"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv
