<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F071E"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Royal Profile & Wallet Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1E103C"
            android:padding="14dp">

            <TextView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:text="👑"
                android:textSize="24sp"
                android:gravity="center"
                android:background="#321B63" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Royal Host"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUserUid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID: 100001 • VIP"
                    android:textColor="#C4B5FD"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪙 50,000"
                android:textColor="#FFD700"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="#2D1959"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp" />
        </LinearLayout>

        <!-- SUPER ADMIN ONLY PANEL (Hidden for normal users) -->
        <LinearLayout
            android:id="@+id/layoutSuperAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#3B0D11"
            android:padding="14dp"
            android:layout_marginTop="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👑 OWNER / SUPER ADMIN CONTROL"
                android:textColor="#FFD700"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send Coins to any UID • Greedy Secret Hint Active"
                android:textColor="#FCA5A5"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <EditText
                    android:id="@+id/etTargetUid"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:hint="User 6-Digit ID"
                    android:inputType="number"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#9CA3AF"
                    android:background="#1F0709"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="6dp" />

                <EditText
                    android:id="@+id/etAdminCoins"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:hint="Coins (+ / -)"
                    android:inputType="numberSigned"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#9CA3AF"
                    android:background="#1F0709"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnAdminSendCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:text="SEND"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:backgroundTint="#FFD700" />
            </LinearLayout>
        </LinearLayout>

        <!-- Daily Bonus & Royal Greedy Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <Button
                android:id="@+id/btnDailyBonus"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="🎁 Daily +2,000"
                android:textColor="#000000"
                android:textStyle="bold"
                android:backgroundTint="#FBBF24"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnGreedyGame"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="🎡 Royal Greedy"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#E11D48" />
        </LinearLayout>

        <!-- Create / Join HD Audio Party Room Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E103C"
            android:padding="16dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙️ HD Voice Party &amp; Rocket Rooms"
                android:textColor="#FFD700"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10-Seat Live Audio • Rocket Gift Combo • Room Greedy"
                android:textColor="#C4B5FD"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <EditText
                android:id="@+id/etRoomId"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Enter Room ID (e.g. 8888)"
                android:text="8888"
                android:textColor="#FFFFFF"
                android:textColorHint="#9CA3AF"
                android:background="#120924"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnCreateRoom"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="🚀 Start Host Room"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#7C3AED"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnJoinRoom"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="🎧 Join Party"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#059669" />
            </LinearLayout>
        </LinearLayout>

        <!-- Logout Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Switch Google Account / Logout"
            android:textColor="#9CA3AF"
            android:backgroundTint="#1E103C"
            android:layout_marginTop="18dp" />

    </LinearLayout>
</ScrollView>
